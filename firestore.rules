rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['email', 'role', 'name', 'phone', 'created_at', 'bio', 'categories', 'location', 'portfolio_links', 'avatar_url', 'display_name']) &&
        request.resource.data.role in ['client', 'freelancer'] &&
        request.resource.data.email == request.auth.token.email;
      allow update: if isOwner(uid) &&
        request.resource.data.keys().hasOnly(['email', 'role', 'name', 'phone', 'created_at', 'bio', 'categories', 'location', 'portfolio_links', 'avatar_url', 'display_name']) &&
        request.resource.data.role in ['client', 'freelancer'] &&
        request.resource.data.email == request.auth.token.email;
      allow delete: if false;
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow create: if isSignedIn() && role() == 'client' && request.resource.data.client_id == request.auth.uid &&
        request.resource.data.keys().hasOnly(['client_id', 'title', 'description', 'category', 'budget_min', 'budget_max', 'timeline', 'status', 'created_at']);
      allow update: if isSignedIn() && resource.data.client_id == request.auth.uid &&
        request.resource.data.client_id == resource.data.client_id;
      allow delete: if isSignedIn() && resource.data.client_id == request.auth.uid;

      match /applications/{appId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/jobs/$(jobId)).data.client_id == request.auth.uid ||
           resource.data.freelancer_id == request.auth.uid);
        allow create: if isSignedIn() && role() == 'freelancer' && request.resource.data.freelancer_id == request.auth.uid &&
          request.resource.data.keys().hasOnly(['job_id', 'freelancer_id', 'message', 'status', 'created_at']);
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/jobs/$(jobId)).data.client_id == request.auth.uid &&
          request.resource.data.freelancer_id == resource.data.freelancer_id &&
          request.resource.data.job_id == resource.data.job_id;
        allow delete: if false;
      }
    }

    match /gigs/{gigId} {
      allow read: if true;
      allow create: if isSignedIn() && role() == 'freelancer' && request.resource.data.freelancer_id == request.auth.uid &&
        request.resource.data.keys().hasOnly(['freelancer_id', 'title', 'description', 'category', 'rate', 'rate_type', 'created_at']);
      allow update: if isSignedIn() && resource.data.freelancer_id == request.auth.uid &&
        request.resource.data.freelancer_id == resource.data.freelancer_id;
      allow delete: if isSignedIn() && resource.data.freelancer_id == request.auth.uid;

      match /bookings/{bookingId} {
        allow read: if isSignedIn() &&
          (get(/databases/$(database)/documents/gigs/$(gigId)).data.freelancer_id == request.auth.uid ||
           resource.data.client_id == request.auth.uid);
        allow create: if isSignedIn() && role() == 'client' && request.resource.data.client_id == request.auth.uid &&
          request.resource.data.keys().hasOnly(['gig_id', 'client_id', 'message', 'status', 'created_at']);
        allow update: if isSignedIn() &&
          get(/databases/$(database)/documents/gigs/$(gigId)).data.freelancer_id == request.auth.uid &&
          request.resource.data.client_id == resource.data.client_id &&
          request.resource.data.gig_id == resource.data.gig_id;
        allow delete: if false;
      }
    }
  }
}
